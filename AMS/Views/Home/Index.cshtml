@{
    Layout = null;
    ViewData["Title"] = "Apex Legal Chambers — Corporate & Litigation Practice";
}
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: { 400: '#f1c40f', 500: '#d4af37', 600: '#aa8c2c' },
                        onyx: { 800: '#12161f', 900: '#0b0e14', 950: '#06080c' }
                    },
                    fontFamily: {
                        serif: ['Georgia', 'Cambria', 'Times New Roman', 'serif']
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .gold-gradient-text {
            background: linear-gradient(135deg, #f3e5ab 0%, #d4af37 50%, #aa8c2c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-border-glow:hover {
            border-color: rgba(212, 175, 55, 0.5);
            box-shadow: 0 10px 30px -10px rgba(212, 175, 55, 0.15);
        }

        .carousel-slide {
            display: none;
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
        }

            .carousel-slide.active {
                display: block;
                opacity: 1;
            }

        .toast {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 100;
            transform: translateX(120%);
            transition: transform 0.35s ease;
        }

            .toast.show {
                transform: translateX(0);
            }
    </style>
</head>
<body class="bg-slate-50 dark:bg-onyx-950 text-slate-800 dark:text-slate-200 antialiased font-sans min-h-screen flex flex-col transition-colors duration-300">

    <!-- Toast (for client-side messages only) -->
    <div id="toast" class="toast hidden">
        <div class="bg-white dark:bg-onyx-900 border border-emerald-500/40 shadow-2xl rounded-xl px-5 py-4 flex items-center gap-3 min-w-[280px]">
            <div class="w-9 h-9 rounded-full bg-emerald-500/15 text-emerald-500 flex items-center justify-center">
                <i class="fas fa-check"></i>
            </div>
            <div>
                <p id="toastTitle" class="text-sm font-bold text-slate-900 dark:text-white">Success</p>
                <p id="toastMsg" class="text-xs text-slate-500 dark:text-slate-400">Action completed.</p>
            </div>
        </div>
    </div>

    <!-- Top Announcement -->
    <div class="bg-slate-200 dark:bg-onyx-900 border-b border-slate-300 dark:border-amber-500/10 text-xs py-2.5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-6 text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-2"><i class="fas fa-landmark text-amber-600 dark:text-amber-500"></i> Supreme Court & Appellate Bar Registered</span>
                <span class="hidden md:flex items-center gap-2"><i class="fas fa-shield-halved text-amber-600 dark:text-amber-500"></i> confidential@apexchambers.com</span>
            </div>
            <div class="flex items-center gap-4 text-xs font-semibold">
                <span class="text-slate-600 dark:text-slate-400">Direct Desk: <strong class="text-amber-600 dark:text-amber-400 font-mono">+1 (800) 770-APEX</strong></span>
                <span class="text-slate-400 dark:text-slate-600">|</span>
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Duty Advocate Active
                </span>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <header class="sticky top-0 z-40 bg-white/90 dark:bg-onyx-900/90 backdrop-blur-lg border-b border-slate-200 dark:border-slate-800/80 shadow-md dark:shadow-2xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-onyx-950 text-xl font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition">
                    <i class="fas fa-scale-balanced"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white block leading-tight font-serif">
                        APEX <span class="gold-gradient-text">CHAMBERS</span>
                    </span>
                    <span class="text-[9px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 font-bold block">Attorneys & Counselors at Law</span>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-8 text-xs uppercase tracking-widest font-semibold text-slate-700 dark:text-slate-300">
                <a href="#overview" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Overview</a>
                <a href="#practices" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Practice Groups</a>
                <a href="#advocates" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Senior Partners</a>
                <a href="#reviews" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Peer Reviews</a>
                <a href="#case-tracker" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Case Portal</a>
                <a href="#consultation" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Chambers Info</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="text-amber-600 dark:text-amber-400 hover:text-amber-500 transition flex items-center gap-1.5">
                        <i class="fas fa-gauge-high"></i> Dashboard
                    </a>
                }
            </nav>

            <div class="flex items-center gap-3">
                <button id="themeToggleBtn" onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-onyx-800 border border-slate-300 dark:border-slate-700 text-amber-600 dark:text-amber-400 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-800 transition shadow">
                    <i id="themeIcon" class="fas fa-moon text-sm"></i>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Logged-in user -->
                    <div class="flex items-center gap-3">
                        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-onyx-800 border border-slate-300 dark:border-slate-700">
                            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-onyx-950 text-xs font-bold">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 max-w-[120px] truncate">
                                @User.Identity.Name
                            </span>
                        </div>
                        <a asp-controller="Dashboard" asp-action="Index"
                           class="px-4 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-onyx-950 font-bold text-xs rounded-xl shadow-lg transition flex items-center gap-2">
                            <i class="fas fa-gauge-high"></i> Dashboard
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-onyx-800 border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:text-red-500 hover:border-red-400/40 transition flex items-center justify-center" title="Sign out">
                                <i class="fas fa-arrow-right-from-bracket text-sm"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <!-- Guest -->
                    <div class="flex items-center gap-3">
                        <button onclick="openAuthModal('login')" class="px-4 py-2.5 bg-slate-100 dark:bg-onyx-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-bold text-xs rounded-xl transition flex items-center gap-2 shadow-sm">
                            <i class="fas fa-right-to-bracket text-amber-600 dark:text-amber-400"></i> Client Login
                        </button>
                        <a href="#consultation" class="hidden sm:flex px-5 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-onyx-950 font-bold text-xs rounded-xl shadow-lg transition duration-200 items-center gap-2">
                            <i class="fas fa-gavel"></i> Schedule Intake
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- ===================== HOME CONTENT ===================== -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full space-y-20">

        <!-- HERO + CASE TRACKER (same as before) -->
        <section id="overview" class="relative rounded-3xl bg-white dark:bg-onyx-800 border border-slate-200 dark:border-slate-800/80 p-8 md:p-14 overflow-hidden shadow-xl dark:shadow-2xl">
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7 space-y-6 relative">
                    <div class="carousel-slide active space-y-6">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-semibold">
                            <i class="fas fa-certificate"></i> Ranked Tier-1 Law Practice 2026
                        </div>
                        <h1 class="text-4xl md:text-5xl font-extrabold font-serif text-slate-900 dark:text-white tracking-tight leading-[1.15]">
                            Strategic Legal Defense & <br />
                            <span class="gold-gradient-text">High-Stakes Corporate Advocacy</span>
                        </h1>
                        <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
                            We defend corporations, executive boards, and high-net-worth individuals in appellate courts, cross-border commercial arbitration, and white-collar defense.
                        </p>
                    </div>
                    <div class="carousel-slide space-y-6">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-semibold">
                            <i class="fas fa-gavel"></i> Supreme Court Practice
                        </div>
                        <h1 class="text-4xl md:text-5xl font-extrabold font-serif text-slate-900 dark:text-white tracking-tight leading-[1.15]">
                            Constitutional Writs & <br />
                            <span class="gold-gradient-text">Appellate Court Litigation</span>
                        </h1>
                        <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
                            Pioneering constitutional writ petitions, habeas corpus proceedings, and strategic defense in the highest appellate divisions.
                        </p>
                    </div>
                    <div class="carousel-slide space-y-6">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-semibold">
                            <i class="fas fa-globe"></i> International Arbitration
                        </div>
                        <h1 class="text-4xl md:text-5xl font-extrabold font-serif text-slate-900 dark:text-white tracking-tight leading-[1.15]">
                            Cross-Border Trade & <br />
                            <span class="gold-gradient-text">Commercial Dispute Resolution</span>
                        </h1>
                        <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
                            Securing client assets in multinational arbitration, M&A disputes, and multi-jurisdiction commercial litigation.
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-4 pt-2">
                        <a href="#consultation" class="px-6 py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-onyx-950 font-bold text-xs rounded-xl shadow-lg transition duration-200 flex items-center gap-2">
                            <i class="fas fa-user-shield"></i> Retain Senior Counsel
                        </a>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <button onclick="openAuthModal('register')" class="px-6 py-3.5 bg-slate-100 dark:bg-onyx-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-300 font-semibold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition duration-200 flex items-center gap-2">
                                <i class="fas fa-user-plus"></i> Create Client Account
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="px-6 py-3.5 bg-slate-100 dark:bg-onyx-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-300 font-semibold text-xs rounded-xl border border-slate-300 dark:border-slate-700 transition duration-200 flex items-center gap-2">
                                <i class="fas fa-gauge-high"></i> Go to Dashboard
                            </a>
                        }
                    </div>
                    <div class="flex items-center gap-4 pt-4">
                        <button onclick="prevSlide()" class="w-9 h-9 rounded-full bg-slate-200 dark:bg-onyx-900 hover:bg-amber-500 hover:text-onyx-950 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 transition flex items-center justify-center text-xs">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <div class="flex gap-2" id="carouselDots">
                            <span onclick="goToSlide(0)" class="w-3 h-3 rounded-full bg-amber-500 cursor-pointer"></span>
                            <span onclick="goToSlide(1)" class="w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer"></span>
                            <span onclick="goToSlide(2)" class="w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer"></span>
                        </div>
                        <button onclick="nextSlide()" class="w-9 h-9 rounded-full bg-slate-200 dark:bg-onyx-900 hover:bg-amber-500 hover:text-onyx-950 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 transition flex items-center justify-center text-xs">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Case Tracker (unchanged) -->
                <div id="case-tracker" class="lg:col-span-5 bg-slate-100 dark:bg-onyx-900/90 border border-slate-300 dark:border-amber-500/20 p-6 md:p-7 rounded-2xl shadow-xl space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-300 dark:border-slate-800">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2 font-serif">
                            <i class="fas fa-magnifying-glass text-amber-600 dark:text-amber-400"></i> Public Case Tracker Portal
                        </h3>
                        <span class="text-[10px] uppercase tracking-widest font-bold text-amber-700 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">Live Sync</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-400">Enter your official filing reference to verify hearing dates and bench status.</p>
                    <form onsubmit="handleCaseSearch(event)" class="space-y-3">
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400 tracking-wider mb-1">Case ID / Filing No.</label>
                            <input type="text" id="caseIdInput" required placeholder="e.g., #HC-2026-9021" class="w-full bg-white dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400 tracking-wider mb-1">Primary Representative Surname</label>
                            <input type="text" required placeholder="e.g., Harrison" class="w-full bg-white dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-amber-500">
                        </div>
                        <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-onyx-950 font-bold text-xs rounded-xl shadow transition flex items-center justify-center gap-2">
                            <i class="fas fa-search"></i> Inspect Case Record
                        </button>
                    </form>
                    <div id="caseSearchResult" class="hidden p-4 bg-white dark:bg-onyx-950 border border-amber-500/30 rounded-xl text-xs space-y-1.5 shadow">
                        <div class="flex justify-between items-center text-emerald-600 dark:text-emerald-400 font-bold">
                            <span><i class="fas fa-check-circle mr-1"></i> Active High Court Bench</span>
                            <span id="displayCaseId" class="text-[10px] text-slate-500 font-mono">HC-2026-9021</span>
                        </div>
                        <p class="text-slate-700 dark:text-slate-300">Next Hearing: <strong class="text-slate-900 dark:text-white">November 12, 2026</strong></p>
                        <p class="text-slate-700 dark:text-slate-300">Presiding Judge: <strong class="text-slate-900 dark:text-white">Appellate Division — Division Bench 02</strong></p>
                        <p class="text-slate-700 dark:text-slate-300">Senior Advocate: <strong class="text-slate-900 dark:text-white">Adv. Rahim Khan</strong></p>
                    </div>
                </div>
            </div>
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        </section>

        <!-- STATS, PRACTICES, ADVOCATES, REVIEWS, CONSULTATION – keep exactly as in your previous version -->
        <!-- (They are unchanged and already professional) -->
        <!-- For brevity the remaining sections (Stats, Practice Groups, Senior Advocates, Testimonials, Consultation form, Footer) stay identical to the file you already have. -->
        <!-- Just paste them from your existing file if needed. The critical part is the Auth Modal below. -->

    </main>

    <!-- Footer (keep your existing footer) -->
    <!-- ===================== AUTH MODAL – REAL POST TO AccountController ===================== -->
    <div id="authModal" class="fixed inset-0 z-50 bg-onyx-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-onyx-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-amber-500 text-sm">
                <i class="fas fa-xmark"></i>
            </button>
            <div id="modalContent"></div>
        </div>
    </div>

    <script>
        // Carousel
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('#carouselDots span');
        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.classList.remove('active');
                if (dots[i]) dots[i].className = 'w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer';
            });
            currentSlide = (index + slides.length) % slides.length;
            slides[currentSlide].classList.add('active');
            if (dots[currentSlide]) dots[currentSlide].className = 'w-3 h-3 rounded-full bg-amber-500 cursor-pointer';
        }
        function nextSlide() { showSlide(currentSlide + 1); }
        function prevSlide() { showSlide(currentSlide - 1); }
        function goToSlide(index) { showSlide(index); }
        setInterval(() => nextSlide(), 6000);

        // Theme
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.className = 'fas fa-moon text-sm';
            } else {
                html.classList.add('dark');
                icon.className = 'fas fa-sun text-sm';
            }
        }

        // Case search
        function handleCaseSearch(e) {
            e.preventDefault();
            const inputVal = document.getElementById('caseIdInput').value;
            document.getElementById('displayCaseId').textContent = inputVal.toUpperCase();
            document.getElementById('caseSearchResult').classList.remove('hidden');
        }

        // Advocate select
        function selectAdvocate(name) {
            const select = document.getElementById('selectedAdvocateInput');
            if (select) select.value = name;
            window.location.hash = '#consultation';
        }

        // Consultation
        function handleConsultationSubmit(e) {
            e.preventDefault();
            showToast('Intake Received', 'Desk Counsel will confirm within 2 hours.');
            e.target.reset();
        }

        function showToast(title, msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMsg').textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('show'), 20);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.classList.add('hidden'), 350);
            }, 3200);
        }



        function openAuthModal(mode) {
            const modal = document.getElementById('authModal');
            const content = document.getElementById('modalContent');

            if (mode === 'login') {
                content.innerHTML = `
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white font-serif mb-1">Client Portal Access</h3>
                    <p class="text-xs text-slate-500 mb-5">Enter credentials to access your confidential dashboard.</p>
                    <form method="post" action="/Account/Login" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="" />
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Email</label>
                            <input type="email" name="Email" required placeholder="client@example.com"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Password</label>
                            <input type="password" name="Password" required placeholder="••••••••"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" name="RememberMe" value="true" id="rememberMe" class="rounded border-slate-400 text-amber-500 focus:ring-amber-500" />
                            <label for="rememberMe" class="text-xs text-slate-500">Remember me</label>
                        </div>
                        <button type="submit" class="w-full py-3 bg-amber-500 text-onyx-950 font-bold text-xs rounded-xl hover:bg-amber-400 transition">
                            Secure Login → Dashboard
                        </button>
                    </form>
                    <p class="text-center text-xs text-slate-500 pt-2">
                        New client? <button type="button" onclick="openAuthModal('register')" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Create account</button>
                    </p>
                `;
            } else {
                content.innerHTML = `
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white font-serif mb-1">Create Portal Account</h3>
                    <p class="text-xs text-slate-500 mb-5">Register to access the client / advocate dashboard.</p>
                    <form method="post" action="/Account/Register" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Full Name</label>
                            <input type="text" name="FullName" required placeholder="John Doe"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Email Address</label>
                            <input type="email" name="Email" required placeholder="john@example.com"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Phone Number</label>
                            <input type="text" name="PhoneNumber" placeholder="+880 1XXX-XXXXXX"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Address</label>
                            <input type="text" name="Address" placeholder="City, Country"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Account Type</label>
                            <select name="AccountType" required
                                    class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                                <option value="Client">Client</option>
                                <option value="Advocate">Advocate</option>
                                <option value="Administrator">Administrator</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mb-1">Password</label>
                            <input type="password" name="Password" required minlength="6" placeholder="••••••••"
                                   class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500" />
                        </div>
                        <button type="submit" class="w-full py-3 bg-amber-500 text-onyx-950 font-bold text-xs rounded-xl hover:bg-amber-400 transition">
                            Register Account → Dashboard
                        </button>
                    </form>
                    <p class="text-center text-xs text-slate-500 pt-2">
                        Already registered? <button type="button" onclick="openAuthModal('login')" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Sign in</button>
                    </p>
                `;
            }
            modal.classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
        }
    </script>
</body>
</html>
                <button id="registerTabBtn" onclick="switchAuthTab('register')" class="py-2.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition">
                    Register Client
                </button>
            </div>

            <!-- LOGIN FORM -->
            <form id="loginForm" onsubmit="handleLoginSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400 mb-1">Email / Client Reference ID</label>
                    <input type="text" required placeholder="client@company.com" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-800 rounded-xl px-4 py-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400">Password</label>
                        <a href="#" class="text-[10px] text-amber-600 dark:text-amber-400 hover:underline">Forgot password?</a>
                    </div>
                    <input type="password" required placeholder="••••••••" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-800 rounded-xl px-4 py-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                </div>
                <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-onyx-950 font-bold text-xs rounded-xl shadow transition flex items-center justify-center gap-2">
                    <i class="fas fa-right-to-bracket"></i> Secure Log In
                </button>
            </form>

            <!-- REGISTER FORM -->
            <form id="registerForm" onsubmit="handleRegisterSubmit(event)" class="space-y-4 hidden">
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400 mb-1">Full Legal Name</label>
                    <input type="text" required placeholder="Jane Doe" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-800 rounded-xl px-4 py-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400 mb-1">Email Address</label>
                    <input type="email" required placeholder="jane@example.com" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-800 rounded-xl px-4 py-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-600 dark:text-slate-400 mb-1">Create Password</label>
                    <input type="password" required placeholder="••••••••" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-800 rounded-xl px-4 py-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                </div>
                <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-onyx-950 font-bold text-xs rounded-xl shadow transition flex items-center justify-center gap-2">
                    <i class="fas fa-user-check"></i> Register Account
                </button>
            </form>

            <!-- Status Alert Container -->
            <div id="authAlert" class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-bold text-center"></div>

        </div>
    </div>

    <!-- INTERACTIVE JAVASCRIPT -->
    <script>
        /* --- DARK / LIGHT THEME TOGGLE --- */
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                html.classList.add('dark');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        }

        /* --- HERO SLIDER CAROUSEL --- */
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('#carouselDots span');
        let autoSlideInterval = setInterval(nextSlide, 5000);

        function updateCarousel() {
            slides.forEach((slide, idx) => {
                slide.classList.toggle('active', idx === currentSlide);
            });
            dots.forEach((dot, idx) => {
                if (idx === currentSlide) {
                    dot.className = 'w-3 h-3 rounded-full bg-amber-500 cursor-pointer';
                } else {
                    dot.className = 'w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer';
                }
            });
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % slides.length;
            updateCarousel();
            resetTimer();
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            updateCarousel();
            resetTimer();
        }

        function goToSlide(index) {
            currentSlide = index;
            updateCarousel();
            resetTimer();
        }

        function resetTimer() {
            clearInterval(autoSlideInterval);
            autoSlideInterval = setInterval(nextSlide, 5000);
        }

        /* --- AUTH MODAL & TABS --- */
        function openAuthModal(tab = 'login') {
            document.getElementById('authModal').classList.remove('hidden');
            switchAuthTab(tab);
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
            document.getElementById('authAlert').classList.add('hidden');
        }

        function switchAuthTab(tab) {
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const loginBtn = document.getElementById('loginTabBtn');
            const registerBtn = document.getElementById('registerTabBtn');

            if (tab === 'login') {
                loginForm.classList.remove('hidden');
                registerForm.classList.add('hidden');
                loginBtn.className = 'py-2.5 rounded-lg bg-white dark:bg-onyx-900 text-slate-900 dark:text-white shadow transition';
                registerBtn.className = 'py-2.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition';
            } else {
                loginForm.classList.add('hidden');
                registerForm.classList.remove('hidden');
                registerBtn.className = 'py-2.5 rounded-lg bg-white dark:bg-onyx-900 text-slate-900 dark:text-white shadow transition';
                loginBtn.className = 'py-2.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition';
            }
        }

        function handleLoginSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('authAlert');
            alertBox.innerHTML = '<i class="fas fa-circle-check mr-1"></i> Authenticated successfully. Redirecting to client portal...';
            alertBox.classList.remove('hidden');
            setTimeout(() => closeAuthModal(), 2000);
        }

        function handleRegisterSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('authAlert');
            alertBox.innerHTML = '<i class="fas fa-circle-check mr-1"></i> Registration complete. Verification email sent!';
            alertBox.classList.remove('hidden');
            setTimeout(() => switchAuthTab('login'), 2000);
        }

        /* --- CASE TRACKER & INTAKE JS --- */
        function handleCaseSearch(event) {
            event.preventDefault();
            document.getElementById('caseSearchResult').classList.remove('hidden');
        }

        function selectAdvocate(advocateName) {
            const advocateSelect = document.getElementById('advocateSelect');
            const caseDesc = document.getElementById('caseDescription');
            
            if (advocateSelect) advocateSelect.value = advocateName;
            if (caseDesc) caseDesc.value = `Requesting legal consultation with ${advocateName}. `;
            
            document.getElementById('consultation').scrollIntoView({ behavior: 'smooth' });
        }

        function handleConsultationSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('consultationAlert');
            alertBox.classList.remove('hidden');
            
            setTimeout(() => {
                alertBox.classList.add('hidden');
                document.getElementById('consultationForm').reset();
            }, 5000);
        }
    </script>
</body>
</html>
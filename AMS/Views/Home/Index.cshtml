@{
    Layout = null;
    ViewData["Title"] = "Apex Legal Chambers — Corporate & Litigation Practice";
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            50:  '#f0f4f8',
                            100: '#d9e2ec',
                            200: '#bcccdc',
                            700: '#334e68',
                            800: '#243b53',
                            900: '#102a43',
                            950: '#0a1929'
                        },
                        gold: {
                            400: '#e6c35c',
                            500: '#d4af37',
                            600: '#b8962e'
                        },
                        cream: {
                            50:  '#fdfbf7',
                            100: '#f8f4ec'
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'Georgia', 'serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .font-serif {
            font-family: 'Playfair Display', Georgia, serif;
        }

        .gold-text {
            background: linear-gradient(135deg, #f0d78c, #d4af37, #b8962e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .carousel-slide {
            display: none;
            opacity: 0;
            transition: opacity 0.7s ease;
        }

            .carousel-slide.active {
                display: block;
                opacity: 1;
            }

        .toast {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 100;
            transform: translateX(120%);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .toast.show {
                transform: translateX(0);
            }
    </style>
</head>
<body class="bg-cream-50 text-navy-900 antialiased min-h-screen flex flex-col">

    <!-- Toast -->
    <div id="toast" class="toast hidden">
        <div class="bg-white border border-emerald-200 shadow-xl rounded-2xl px-5 py-4 flex items-center gap-3 min-w-[290px]">
            <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fas fa-check text-sm"></i>
            </div>
            <div>
                <p id="toastTitle" class="text-sm font-semibold text-navy-900">Success</p>
                <p id="toastMsg" class="text-xs text-navy-700/70 mt-0.5">Action completed.</p>
            </div>
        </div>
    </div>

    <!-- Top Info Bar -->
    <div class="bg-navy-950 text-navy-100 text-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-6">
                <span class="flex items-center gap-2">
                    <i class="fas fa-landmark text-gold-500"></i>
                    Supreme Court & Appellate Bar Registered
                </span>
                <span class="hidden md:flex items-center gap-2">
                    <i class="fas fa-envelope text-gold-500"></i>
                    confidential@apexchambers.com
                </span>
            </div>
            <div class="flex items-center gap-4 font-medium">
                <span>
                    Direct Desk: <strong class="text-gold-400 font-mono tracking-wide">+1 (800) 770-APEX</strong>
                </span>
                <span class="text-navy-700">|</span>
                <span class="text-emerald-400 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Duty Advocate Active
                </span>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-navy-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[76px] flex items-center justify-between">

            <!-- Logo -->
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-xl bg-navy-900 flex items-center justify-center text-gold-400 text-xl shadow-lg group-hover:scale-105 transition-transform">
                    <i class="fas fa-scale-balanced"></i>
                </div>
                <div>
                    <span class="text-xl font-bold tracking-tight text-navy-900 block leading-none font-serif">
                        APEX <span class="text-gold-500">CHAMBERS</span>
                    </span>
                    <span class="text-[9px] uppercase tracking-[0.22em] text-navy-700/60 font-semibold block mt-0.5">
                        Attorneys & Counselors at Law
                    </span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden lg:flex items-center gap-8 text-[12px] uppercase tracking-[0.14em] font-semibold text-navy-700">
                <a href="#overview" class="hover:text-navy-900 transition">Overview</a>
                <a href="#practices" class="hover:text-navy-900 transition">Practice Groups</a>
                <a href="#advocates" class="hover:text-navy-900 transition">Senior Partners</a>
                <a href="#reviews" class="hover:text-navy-900 transition">Peer Reviews</a>
                <a href="#case-tracker" class="hover:text-navy-900 transition">Case Portal</a>
                <a href="#consultation" class="hover:text-navy-900 transition">Contact</a>
            </nav>

            <!-- Right Actions -->
            <div class="flex items-center gap-3">
                <button onclick="openAuthModal('login')"
                        class="px-4 py-2.5 text-navy-800 font-semibold text-sm rounded-lg border border-navy-200 hover:bg-navy-50 transition flex items-center gap-2">
                    <i class="fas fa-right-to-bracket text-gold-600"></i>
                    Client Login
                </button>
                <a href="#consultation"
                   class="hidden sm:flex px-5 py-2.5 bg-navy-900 hover:bg-navy-800 text-white font-semibold text-sm rounded-lg shadow-md transition items-center gap-2">
                    <i class="fas fa-gavel text-gold-400"></i>
                    Schedule Intake
                </a>
            </div>
        </div>
    </header>

    <!-- ===================== MAIN ===================== -->
    <main class="flex-grow">

        <!-- HERO SECTION -->
        <section id="overview" class="relative bg-navy-950 text-white overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-navy-800/40 via-navy-950 to-navy-950"></div>

            <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

                    <!-- Left Content -->
                    <div class="lg:col-span-7 space-y-8">
                        <div class="carousel-slide active space-y-6">
                            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold">
                                <i class="fas fa-certificate"></i> Ranked Tier-1 Law Practice 2026
                            </div>
                            <h1 class="text-4xl md:text-5xl lg:text-[3.4rem] font-bold font-serif tracking-tight leading-[1.15]">
                                Strategic Legal Defense &<br>
                                <span class="gold-text">High-Stakes Corporate Advocacy</span>
                            </h1>
                            <p class="text-navy-200 text-lg leading-relaxed max-w-xl">
                                We defend corporations, executive boards, and high-net-worth individuals in appellate courts, cross-border commercial arbitration, and white-collar defense.
                            </p>
                        </div>

                        <div class="carousel-slide space-y-6">
                            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold">
                                <i class="fas fa-gavel"></i> Supreme Court Practice
                            </div>
                            <h1 class="text-4xl md:text-5xl lg:text-[3.4rem] font-bold font-serif tracking-tight leading-[1.15]">
                                Constitutional Writs &<br>
                                <span class="gold-text">Appellate Court Litigation</span>
                            </h1>
                            <p class="text-navy-200 text-lg leading-relaxed max-w-xl">
                                Pioneering constitutional writ petitions, habeas corpus proceedings, and strategic defense in the highest appellate divisions.
                            </p>
                        </div>

                        <div class="carousel-slide space-y-6">
                            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold">
                                <i class="fas fa-globe"></i> International Arbitration
                            </div>
                            <h1 class="text-4xl md:text-5xl lg:text-[3.4rem] font-bold font-serif tracking-tight leading-[1.15]">
                                Cross-Border Trade &<br>
                                <span class="gold-text">Commercial Dispute Resolution</span>
                            </h1>
                            <p class="text-navy-200 text-lg leading-relaxed max-w-xl">
                                Securing client assets in multinational arbitration, M&A disputes, and multi-jurisdiction commercial litigation.
                            </p>
                        </div>

                        <!-- CTAs -->
                        <div class="flex flex-wrap gap-4 pt-2">
                            <a href="#consultation"
                               class="px-7 py-3.5 bg-gold-500 hover:bg-gold-400 text-navy-950 font-semibold text-sm rounded-lg shadow-lg shadow-gold-500/20 transition flex items-center gap-2">
                                <i class="fas fa-user-shield"></i> Retain Senior Counsel
                            </a>
                            <button onclick="openAuthModal('register')"
                                    class="px-7 py-3.5 bg-white/5 hover:bg-white/10 text-white font-medium text-sm rounded-lg border border-white/15 transition flex items-center gap-2">
                                <i class="fas fa-user-plus"></i> Create Client Account
                            </button>
                        </div>

                        <!-- Carousel Dots -->
                        <div class="flex items-center gap-3 pt-6">
                            <button onclick="prevSlide()" class="w-9 h-9 rounded-full bg-white/5 hover:bg-gold-500 hover:text-navy-950 text-white/70 border border-white/10 transition flex items-center justify-center text-xs">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <div class="flex gap-2" id="carouselDots">
                                <span onclick="goToSlide(0)" class="w-2.5 h-2.5 rounded-full bg-gold-500 cursor-pointer"></span>
                                <span onclick="goToSlide(1)" class="w-2.5 h-2.5 rounded-full bg-white/25 cursor-pointer"></span>
                                <span onclick="goToSlide(2)" class="w-2.5 h-2.5 rounded-full bg-white/25 cursor-pointer"></span>
                            </div>
                            <button onclick="nextSlide()" class="w-9 h-9 rounded-full bg-white/5 hover:bg-gold-500 hover:text-navy-950 text-white/70 border border-white/10 transition flex items-center justify-center text-xs">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Right: Case Tracker Card -->
                    <div id="case-tracker" class="lg:col-span-5">
                        <div class="bg-white text-navy-900 rounded-2xl p-7 shadow-2xl border border-navy-100">
                            <div class="flex items-center justify-between pb-4 border-b border-navy-100">
                                <h3 class="text-lg font-bold font-serif flex items-center gap-2.5">
                                    <i class="fas fa-magnifying-glass text-gold-600"></i>
                                    Case Tracker Portal
                                </h3>
                                <span class="text-[10px] uppercase tracking-widest font-bold text-gold-700 bg-gold-500/10 px-2.5 py-1 rounded-md border border-gold-500/20">
                                    Live
                                </span>
                            </div>

                            <p class="text-sm text-navy-700/70 mt-4 mb-6">
                                Enter your official filing reference to verify hearing dates and bench status.
                            </p>

                            <form onsubmit="handleCaseSearch(event)" class="space-y-4">
                                <div>
                                    <label class="block text-[11px] uppercase font-semibold text-navy-700/60 tracking-wider mb-1.5">
                                        Case ID / Filing No.
                                    </label>
                                    <input type="text" id="caseIdInput" required placeholder="e.g., #HC-2026-9021"
                                           class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition">
                                </div>
                                <div>
                                    <label class="block text-[11px] uppercase font-semibold text-navy-700/60 tracking-wider mb-1.5">
                                        Primary Representative Surname
                                    </label>
                                    <input type="text" required placeholder="e.g., Harrison"
                                           class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition">
                                </div>
                                <button type="submit"
                                        class="w-full py-3.5 bg-navy-900 hover:bg-navy-800 text-white font-semibold text-sm rounded-xl transition flex items-center justify-center gap-2 mt-1">
                                    <i class="fas fa-search"></i> Inspect Case Record
                                </button>
                            </form>

                            <!-- Result -->
                            <div id="caseSearchResult" class="hidden mt-5 p-4 bg-cream-50 border border-gold-500/30 rounded-xl text-sm space-y-2">
                                <div class="flex justify-between items-center text-emerald-700 font-semibold">
                                    <span><i class="fas fa-check-circle mr-1.5"></i> Active High Court Bench</span>
                                    <span id="displayCaseId" class="text-[11px] text-navy-500 font-mono">HC-2026-9021</span>
                                </div>
                                <p>Next Hearing: <strong>November 12, 2026</strong></p>
                                <p>Presiding Judge: <strong>Appellate Division — Bench 02</strong></p>
                                <p>Senior Advocate: <strong>Adv. Rahim Khan</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- STATS BAR -->
        <section class="bg-white border-b border-navy-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    <div>
                        <div class="text-3xl font-bold font-serif text-navy-900">28+</div>
                        <div class="text-sm text-navy-700/70 mt-1">Years of Excellence</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold font-serif text-navy-900">1,200+</div>
                        <div class="text-sm text-navy-700/70 mt-1">Cases Successfully Handled</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold font-serif text-navy-900">94%</div>
                        <div class="text-sm text-navy-700/70 mt-1">Favorable Outcomes</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold font-serif text-navy-900">18</div>
                        <div class="text-sm text-navy-700/70 mt-1">Senior Partners</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRACTICE GROUPS -->
        <section id="practices" class="py-20 bg-cream-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-14">
                    <h2 class="text-3xl md:text-4xl font-bold font-serif text-navy-900">Practice Groups</h2>
                    <p class="text-navy-700/70 mt-3">Focused expertise across the most demanding areas of law.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Card 1 -->
                    <div class="bg-white rounded-2xl p-7 border border-navy-100 hover:border-gold-500/40 hover:shadow-lg transition group">
                        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                            <i class="fas fa-building-columns"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900 mb-2">Corporate & Commercial</h3>
                        <p class="text-navy-700/70 text-sm leading-relaxed">
                            Complex commercial litigation, shareholder disputes, and high-value contract enforcement.
                        </p>
                    </div>

                    <!-- Card 2 -->
                    <div class="bg-white rounded-2xl p-7 border border-navy-100 hover:border-gold-500/40 hover:shadow-lg transition group">
                        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                            <i class="fas fa-gavel"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900 mb-2">Appellate & Constitutional</h3>
                        <p class="text-navy-700/70 text-sm leading-relaxed">
                            Supreme Court practice, constitutional writs, and strategic appellate advocacy.
                        </p>
                    </div>

                    <!-- Card 3 -->
                    <div class="bg-white rounded-2xl p-7 border border-navy-100 hover:border-gold-500/40 hover:shadow-lg transition group">
                        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                            <i class="fas fa-globe"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900 mb-2">International Arbitration</h3>
                        <p class="text-navy-700/70 text-sm leading-relaxed">
                            Cross-border disputes, investor-state arbitration, and multi-jurisdiction enforcement.
                        </p>
                    </div>

                    <!-- Card 4 -->
                    <div class="bg-white rounded-2xl p-7 border border-navy-100 hover:border-gold-500/40 hover:shadow-lg transition group">
                        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900 mb-2">White-Collar Defense</h3>
                        <p class="text-navy-700/70 text-sm leading-relaxed">
                            Regulatory investigations, corporate crime defense, and executive protection.
                        </p>
                    </div>

                    <!-- Card 5 -->
                    <div class="bg-white rounded-2xl p-7 border border-navy-100 hover:border-gold-500/40 hover:shadow-lg transition group">
                        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                            <i class="fas fa-handshake"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900 mb-2">Mergers & Acquisitions</h3>
                        <p class="text-navy-700/70 text-sm leading-relaxed">
                            Deal advisory, post-merger disputes, and complex transactional litigation.
                        </p>
                    </div>

                    <!-- Card 6 -->
                    <div class="bg-white rounded-2xl p-7 border border-navy-100 hover:border-gold-500/40 hover:shadow-lg transition group">
                        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                            <i class="fas fa-landmark"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900 mb-2">Banking & Finance</h3>
                        <p class="text-navy-700/70 text-sm leading-relaxed">
                            Financial regulation, insolvency, and high-stakes banking litigation.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SENIOR PARTNERS -->
        <section id="advocates" class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-14">
                    <h2 class="text-3xl md:text-4xl font-bold font-serif text-navy-900">Senior Partners</h2>
                    <p class="text-navy-700/70 mt-3">Experienced advocates trusted by boards and high-net-worth clients.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Partner 1 -->
                    <div class="bg-cream-50 rounded-2xl p-6 border border-navy-100 text-center">
                        <div class="w-24 h-24 rounded-full bg-navy-900 text-gold-400 flex items-center justify-center text-3xl mx-auto mb-5">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900">Adv. Rahim Khan</h3>
                        <p class="text-gold-600 text-sm font-medium mt-1">Senior Partner — Appellate</p>
                        <p class="text-navy-700/70 text-sm mt-3">Supreme Court practice with 22+ years of appellate excellence.</p>
                    </div>

                    <!-- Partner 2 -->
                    <div class="bg-cream-50 rounded-2xl p-6 border border-navy-100 text-center">
                        <div class="w-24 h-24 rounded-full bg-navy-900 text-gold-400 flex items-center justify-center text-3xl mx-auto mb-5">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900">Adv. Sophia Rahman</h3>
                        <p class="text-gold-600 text-sm font-medium mt-1">Partner — Corporate Litigation</p>
                        <p class="text-navy-700/70 text-sm mt-3">Specialist in high-value commercial disputes and board advisory.</p>
                    </div>

                    <!-- Partner 3 -->
                    <div class="bg-cream-50 rounded-2xl p-6 border border-navy-100 text-center">
                        <div class="w-24 h-24 rounded-full bg-navy-900 text-gold-400 flex items-center justify-center text-3xl mx-auto mb-5">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <h3 class="text-xl font-bold font-serif text-navy-900">Adv. Imran Ali</h3>
                        <p class="text-gold-600 text-sm font-medium mt-1">Partner — International Arbitration</p>
                        <p class="text-navy-700/70 text-sm mt-3">Cross-border arbitration and multi-jurisdictional enforcement.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CONSULTATION -->
        <section id="consultation" class="py-20 bg-navy-950 text-white">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-10">
                    <h2 class="text-3xl md:text-4xl font-bold font-serif">Schedule a Confidential Intake</h2>
                    <p class="text-navy-200 mt-3">Our desk counsel will respond within 2 business hours.</p>
                </div>

                <form onsubmit="handleConsultationSubmit(event)" class="bg-white/5 border border-white/10 rounded-2xl p-8 space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-200 mb-1.5">Full Name</label>
                            <input type="text" required class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/40 focus:outline-none focus:border-gold-500 transition" placeholder="Your full name">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-200 mb-1.5">Email</label>
                            <input type="email" required class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/40 focus:outline-none focus:border-gold-500 transition" placeholder="you@example.com">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-navy-200 mb-1.5">Phone</label>
                        <input type="text" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/40 focus:outline-none focus:border-gold-500 transition" placeholder="+1 (555) 000-0000">
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-navy-200 mb-1.5">Brief Description</label>
                        <textarea rows="4" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/40 focus:outline-none focus:border-gold-500 transition" placeholder="Describe your matter confidentially..."></textarea>
                    </div>
                    <button type="submit" class="w-full py-3.5 bg-gold-500 hover:bg-gold-400 text-navy-950 font-semibold rounded-xl transition">
                        Submit Confidential Inquiry
                    </button>
                </form>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="bg-navy-900 text-navy-200 py-12 border-t border-navy-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-navy-800 text-gold-400 flex items-center justify-center">
                            <i class="fas fa-scale-balanced"></i>
                        </div>
                        <div>
                            <div class="font-bold text-white font-serif">APEX CHAMBERS</div>
                            <div class="text-xs text-navy-400">Attorneys & Counselors at Law</div>
                        </div>
                    </div>
                    <div class="text-sm text-navy-400">
                        © 2026 Apex Legal Chambers. All rights reserved.
                    </div>
                </div>
            </div>
        </footer>
    </main>

    <!-- AUTH MODAL -->
    <div id="authModal" class="fixed inset-0 z-50 bg-navy-950/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeAuthModal()" class="absolute top-5 right-5 text-navy-400 hover:text-navy-900 transition">
                <i class="fas fa-xmark text-lg"></i>
            </button>
            <div id="modalContent"></div>
        </div>
    </div>

    <script>
        // Carousel
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('#carouselDots span');

        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.classList.remove('active');
                if (dots[i]) dots[i].className = 'w-2.5 h-2.5 rounded-full bg-white/25 cursor-pointer';
            });
            currentSlide = (index + slides.length) % slides.length;
            slides[currentSlide].classList.add('active');
            if (dots[currentSlide]) dots[currentSlide].className = 'w-2.5 h-2.5 rounded-full bg-gold-500 cursor-pointer';
        }

        function nextSlide() { showSlide(currentSlide + 1); }
        function prevSlide() { showSlide(currentSlide - 1); }
        function goToSlide(index) { showSlide(index); }

        setInterval(() => nextSlide(), 7000);

        // Case Search
        function handleCaseSearch(e) {
            e.preventDefault();
            const inputVal = document.getElementById('caseIdInput').value;
            document.getElementById('displayCaseId').textContent = inputVal.toUpperCase();
            document.getElementById('caseSearchResult').classList.remove('hidden');
        }

        function handleConsultationSubmit(e) {
            e.preventDefault();
            showToast('Intake Received', 'Desk Counsel will confirm within 2 hours.');
            e.target.reset();
        }

        function showToast(title, msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMsg').textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('show'), 20);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.classList.add('hidden'), 350);
            }, 3200);
        }

        // Auth Modal
        function openAuthModal(mode) {
            const modal = document.getElementById('authModal');
            const content = document.getElementById('modalContent');

            if (mode === 'login') {
                content.innerHTML = `
                    <div class="mb-6">
                        <h3 class="text-2xl font-bold font-serif text-navy-900">Client Portal Access</h3>
                        <p class="text-sm text-navy-700/70 mt-1">Enter your credentials to continue.</p>
                    </div>
                    <form method="post" action="/Account/Login" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-700/60 mb-1.5">Email Address</label>
                            <input type="email" name="Email" required placeholder="client@example.com"
                                   class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-700/60 mb-1.5">Password</label>
                            <input type="password" name="Password" required placeholder="••••••••"
                                   class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition" />
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" name="RememberMe" value="true" id="rememberMe" class="rounded border-navy-300 text-gold-500 focus:ring-gold-500" />
                            <label for="rememberMe" class="text-sm text-navy-700/70">Remember me</label>
                        </div>
                        <button type="submit" class="w-full py-3.5 bg-navy-900 hover:bg-navy-800 text-white font-semibold text-sm rounded-xl transition">
                            Sign In
                        </button>
                    </form>
                    <p class="text-center text-sm text-navy-700/70 mt-5">
                        New client?
                        <button type="button" onclick="openAuthModal('register')" class="text-gold-600 font-medium hover:underline">Create account</button>
                    </p>
                `;
            } else {
                content.innerHTML = `
                    <div class="mb-6">
                        <h3 class="text-2xl font-bold font-serif text-navy-900">Create Client Account</h3>
                        <p class="text-sm text-navy-700/70 mt-1">Register for the client portal.</p>
                    </div>
                    <form method="post" action="/Account/Register" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-700/60 mb-1.5">Full Name</label>
                            <input type="text" name="FullName" required placeholder="John Doe"
                                   class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-700/60 mb-1.5">Email Address</label>
                            <input type="email" name="Email" required placeholder="john@example.com"
                                   class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-700/60 mb-1.5">Phone Number</label>
                            <input type="text" name="PhoneNumber" placeholder="+1 (555) 000-0000"
                                   class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-navy-700/60 mb-1.5">Password</label>
                            <input type="password" name="Password" required minlength="6" placeholder="••••••••"
                                   class="w-full bg-cream-50 border border-navy-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 transition" />
                        </div>
                        <button type="submit" class="w-full py-3.5 bg-navy-900 hover:bg-navy-800 text-white font-semibold text-sm rounded-xl transition">
                            Create Account
                        </button>
                    </form>
                    <p class="text-center text-sm text-navy-700/70 mt-5">
                        Already registered?
                        <button type="button" onclick="openAuthModal('login')" class="text-gold-600 font-medium hover:underline">Sign in</button>
                    </p>
                `;
            }
            modal.classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
        }
    </script>
</body>
</html>
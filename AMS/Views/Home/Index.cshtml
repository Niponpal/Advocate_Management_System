    <!-- Scripts -->
    <script>
        // Carousel Functionality
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('#carouselDots span');

        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.classList.remove('active');
                if (dots[i]) {
                    dots[i].className = 'w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer';
                }
            });
            currentSlide = (index + slides.length) % slides.length;
            slides[currentSlide].classList.add('active');
            if (dots[currentSlide]) {
                dots[currentSlide].className = 'w-3 h-3 rounded-full bg-amber-500 cursor-pointer';
            }
        }

        function nextSlide() { showSlide(currentSlide + 1); }
        function prevSlide() { showSlide(currentSlide - 1); }
        function goToSlide(index) { showSlide(index); }

        setInterval(() => { nextSlide(); }, 6000);

        // Dark/Light Theme Switcher
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.className = 'fas fa-moon text-sm';
            } else {
                html.classList.add('dark');
                icon.className = 'fas fa-sun text-sm';
            }
        }

        // Case Search Form Handler
        function handleCaseSearch(e) {
            e.preventDefault();
            const inputVal = document.getElementById('caseIdInput').value;
            const resultDiv = document.getElementById('caseSearchResult');
            const displayId = document.getElementById('displayCaseId');

            displayId.textContent = inputVal.toUpperCase();
            resultDiv.classList.remove('hidden');
        }

        // Select Advocate to pre-fill consultation form
        function selectAdvocate(name) {
            const select = document.getElementById('selectedAdvocateInput');
            if (select) {
                select.value = name;
            }
            window.location.hash = '#consultation';
        }

        // Handle Consultation Submit
        function handleConsultationSubmit(e) {
            e.preventDefault();
            alert('Your privilege-protected intake submission has been received by Chambers. Desk Counsel will confirm within 2 hours.');
            e.target.reset();
        }

        // Auth Modal Handlers
        function openAuthModal(mode) {
            const modal = document.getElementById('authModal');
            const content = document.getElementById('modalContent');

            if (mode === 'login') {
                content.innerHTML = `
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white font-serif mb-2">Client Portal Access</h3>
                    <p class="text-xs text-slate-500 mb-4">Enter credentials to access confidential case filings.</p>
                    <form onsubmit="event.preventDefault(); alert('Logged in successfully'); closeAuthModal();" class="space-y-3">
                        <input type="email" required placeholder="Client Email" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                        <input type="password" required placeholder="Password" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                        <button type="submit" class="w-full py-3 bg-amber-500 text-onyx-950 font-bold text-xs rounded-xl hover:bg-amber-400 transition">Secure Login</button>
                    </form>
                `;
            } else {
                content.innerHTML = `
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white font-serif mb-2">Create Portal Account</h3>
                    <p class="text-xs text-slate-500 mb-4">Register your client profile for secure case communication.</p>
                    <form onsubmit="event.preventDefault(); alert('Account created successfully'); closeAuthModal();" class="space-y-3">
                        <input type="text" required placeholder="Full Name" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                        <input type="email" required placeholder="Email Address" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                        <input type="password" required placeholder="Password" class="w-full bg-slate-50 dark:bg-onyx-950 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500">
                        <button type="submit" class="w-full py-3 bg-amber-500 text-onyx-950 font-bold text-xs rounded-xl hover:bg-amber-400 transition">Register Account</button>
                    </form>
                `;
            }
            modal.classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');

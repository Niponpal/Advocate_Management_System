@{
    Layout = null;
    ViewData["Title"] = "Apex Legal Chambers";
 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apex Legal Chambers | Trusted Legal Solutions</title>

    <!-- Prevent theme flash -->
    <script>
        try {
            if (localStorage.getItem("ams-theme") === "dark") {
                document.documentElement.classList.add("dark");
            }
        } catch (e) { }
    </script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ink: "#172033",
                        gold: "#C5A46D",
                        cream: "#F8F6F1"
                    },
                    fontFamily: {
                        sans: ["Inter", "sans-serif"],
                        serif: ["Playfair Display", "serif"]
                    }
                }
            }
        };
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #ffffff;
            color: #172033;
            transition: background-color .25s ease, color .25s ease;
        }

        .font-serif {
            font-family: "Playfair Display", serif;
        }

        .gold-text {
            color: #C5A46D;
        }

        .gold-button {
            background: #C5A46D;
            color: #172033;
            transition: all .25s ease;
        }

            .gold-button:hover {
                background: #D8B984;
                transform: translateY(-2px);
            }

        .service-card {
            transition: transform .25s ease, background-color .25s ease, border-color .25s ease, box-shadow .25s ease;
        }

            .service-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 35px rgba(15, 23, 42, .08);
            }

        .hero-overlay {
            background: linear-gradient( 90deg, rgba(11, 18, 32, .96) 0%, rgba(11, 18, 32, .84) 52%, rgba(11, 18, 32, .35) 100% );
        }

        .theme-transition,
        header,
        section,
        footer,
        article,
        nav,
        #mobileMenu,
        input,
        textarea,
        select {
            transition: background-color .25s ease, color .25s ease, border-color .25s ease;
        }

        /* Dark theme */
        html.dark body {
            background: #0B1220;
            color: #E5E7EB;
        }

        html.dark header,
        html.dark #mobileMenu {
            background-color: #111C2D !important;
            border-color: #334155 !important;
        }

            html.dark header a,
            html.dark #mobileMenu a {
                color: #E5E7EB;
            }

        html.dark section.bg-white,
        html.dark .bg-white {
            background-color: #111C2D !important;
            color: #E5E7EB;
        }

        html.dark .bg-cream {
            background-color: #172235 !important;
        }

        html.dark .text-ink {
            color: #F1F5F9 !important;
        }

        html.dark .text-slate-900 {
            color: #F8FAFC !important;
        }

        html.dark .text-slate-800 {
            color: #E2E8F0 !important;
        }

        html.dark .text-slate-700 {
            color: #CBD5E1 !important;
        }

        html.dark .text-slate-600,
        html.dark .text-slate-500,
        html.dark .text-slate-400 {
            color: #AAB6C5 !important;
        }

        html.dark .border-slate-200,
        html.dark .border-slate-100 {
            border-color: #334155 !important;
        }

        html.dark .service-card {
            background-color: #111C2D;
            border-color: #334155;
            color: #E5E7EB;
        }

            html.dark .service-card.bg-cream {
                background-color: #172235 !important;
            }

        html.dark input,
        html.dark select,
        html.dark textarea {
            background-color: #0B1220 !important;
            color: #F8FAFC !important;
            border-color: #475569 !important;
        }

            html.dark input::placeholder,
            html.dark textarea::placeholder {
                color: #94A3B8;
            }

        html.dark .bg-amber-50 {
            background-color: #422006 !important;
        }

        html.dark .text-amber-800 {
            color: #FDE68A !important;
        }

        html.dark .bg-slate-50 {
            background-color: #0F1A2B !important;
        }

        html.dark .bg-slate-100 {
            background-color: #1E293B !important;
        }

        html.dark .shadow-sm,
        html.dark .shadow-lg,
        html.dark .shadow-xl {
            box-shadow: 0 8px 30px rgba(0, 0, 0, .18);
        }

        .reveal {
            opacity: 0;
            transform: translateY(18px);
            transition: opacity .6s ease, transform .6s ease;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after

        {
            scroll-behavior: auto !important;
            transition-duration: .01ms !important;
            animation-duration: .01ms !important;
        }

        .reveal {
            opacity: 1;
            transform: none;
        }

        }
    </style>
</head>

<body class="antialiased">

    <!-- Announcement bar -->
    <div class="bg-ink px-4 py-2 text-center text-xs text-white sm:text-sm">
        <i class="fa-solid fa-scale-balanced gold-text mr-2"></i>
        Professional Legal Guidance. Trusted Representation.
        <a href="#contact" class="ml-2 font-semibold gold-text underline">
            Book a Consultation
        </a>
    </div>

    <!-- Navbar -->
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">

            <a asp-controller="Home" asp-action="Index"
               class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-ink text-xl text-white">
                    <i class="fa-solid fa-scale-balanced gold-text"></i>
                </div>

                <div>
                    <span class="block font-serif text-lg font-bold text-ink sm:text-xl">
                        Apex Legal
                    </span>
                    <span class="block text-[10px] uppercase tracking-[.24em] text-slate-500">
                        Chambers
                    </span>
                </div>
            </a>

            <nav class="hidden items-center gap-7 lg:flex">
                <a href="#home" class="text-sm font-medium hover:text-gold">Home</a>
                <a href="#about" class="text-sm font-medium hover:text-gold">About</a>
                <a href="#practice" class="text-sm font-medium hover:text-gold">Practice Areas</a>
                <a href="#team" class="text-sm font-medium hover:text-gold">Our Team</a>
                <a href="#contact" class="text-sm font-medium hover:text-gold">Contact</a>
            </nav>

            <div class="flex items-center gap-2">
                <!-- Dark / Light Toggle -->
                <button id="themeToggle"
                        type="button"
                        aria-label="Switch to dark mode"
                        title="Toggle dark and light mode"
                        class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-ink hover:border-gold">
                    <i id="themeIcon" class="fa-solid fa-moon text-lg"></i>
                </button>

                <a asp-controller="Account" asp-action="Login"
                   class="hidden rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold hover:border-gold sm:inline-flex">
                    Login
                </a>

                <a asp-controller="Account" asp-action="Register"
                   class="gold-button hidden rounded-lg px-4 py-2.5 text-sm font-semibold sm:inline-flex">
                    Get Started
                </a>

                <button id="menuButton"
                        type="button"
                        aria-label="Open navigation menu"
                        aria-expanded="false"
                        class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 lg:hidden">
                    <i id="menuIcon" class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobileMenu" class="hidden border-t border-slate-200 bg-white px-4 py-4 lg:hidden">
            <nav class="mx-auto flex max-w-7xl flex-col gap-4">
                <a href="#home" class="py-1 text-sm font-medium">Home</a>
                <a href="#about" class="py-1 text-sm font-medium">About</a>
                <a href="#practice" class="py-1 text-sm font-medium">Practice Areas</a>
                <a href="#team" class="py-1 text-sm font-medium">Our Team</a>
                <a href="#contact" class="py-1 text-sm font-medium">Contact</a>

                <div class="flex gap-3 border-t border-slate-200 pt-4">
                    <a asp-controller="Account" asp-action="Login"
                       class="flex-1 rounded-lg border border-slate-200 px-4 py-3 text-center text-sm font-semibold">
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="gold-button flex-1 rounded-lg px-4 py-3 text-center text-sm font-semibold">
                        Register
                    </a>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section id="home" class="relative overflow-hidden bg-ink text-white">
            <div class="absolute inset-0">
                <img src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=2000&q=85"
                     alt="Legal books and courtroom"
                     class="h-full w-full object-cover"
                     onerror="this.style.display='none'" />
                <div class="hero-overlay absolute inset-0"></div>
            </div>

            <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-2 lg:px-8 lg:py-32">
                <div class="reveal">
                    <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[.2em] text-amber-200">
                        <span class="h-2 w-2 rounded-full bg-gold"></span>
                        Trusted Legal Excellence
                    </span>

                    <h1 class="max-w-2xl font-serif text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">
                        Legal Solutions Built on
                        <span class="gold-text">Trust & Integrity.</span>
                    </h1>

                    <p class="mt-6 max-w-xl text-base leading-8 text-slate-300 sm:text-lg">
                        Professional legal guidance and client-focused representation
                        to help you navigate complex legal challenges with confidence.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-4">
                        <a href="#contact"
                           class="gold-button inline-flex items-center gap-2 rounded-lg px-6 py-3.5 font-semibold">
                            Book a Consultation
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                        <a href="#practice"
                           class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3.5 font-semibold text-white hover:bg-white/10">
                            Explore Our Services
                        </a>
                    </div>

                    <div class="mt-12 grid max-w-lg grid-cols-3 gap-5 border-t border-white/20 pt-7">
                        <div>
                            <p class="font-serif text-3xl font-bold gold-text">10+</p>
                            <p class="mt-1 text-xs text-slate-300 sm:text-sm">Years of Practice</p>
                        </div>
                        <div>
                            <p class="font-serif text-3xl font-bold gold-text">500+</p>
                            <p class="mt-1 text-xs text-slate-300 sm:text-sm">Clients Served</p>
                        </div>
                        <div>
                            <p class="font-serif text-3xl font-bold gold-text">95%</p>
                            <p class="mt-1 text-xs text-slate-300 sm:text-sm">Client Satisfaction</p>
                        </div>
                    </div>
                </div>

                <!-- Consultation card -->
                <div class="reveal mx-auto w-full max-w-md rounded-2xl border border-white/15 bg-slate-950/70 p-6 shadow-2xl backdrop-blur-md sm:p-8">
                    <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-gold text-2xl text-ink">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>

                    <p class="text-xs font-bold uppercase tracking-[.2em] gold-text">
                        Your Legal Partner
                    </p>

                    <h2 class="mt-3 font-serif text-3xl font-semibold text-white">
                        Let's Discuss Your Case
                    </h2>

                    <p class="mt-4 leading-7 text-slate-300">
                        Get in touch with our team to discuss your legal concerns
                        and explore your available options.
                    </p>

                    <div class="mt-7 space-y-4">
                        <div class="flex gap-3">
                            <i class="fa-solid fa-circle-check mt-1 gold-text"></i>
                            <span class="text-sm text-slate-200">Confidential client consultations</span>
                        </div>
                        <div class="flex gap-3">
                            <i class="fa-solid fa-circle-check mt-1 gold-text"></i>
                            <span class="text-sm text-slate-200">Clear legal guidance and communication</span>
                        </div>
                        <div class="flex gap-3">
                            <i class="fa-solid fa-circle-check mt-1 gold-text"></i>
                            <span class="text-sm text-slate-200">Solutions tailored to your situation</span>
                        </div>
                    </div>

                    <a href="#contact"
                       class="gold-button mt-8 flex w-full items-center justify-center gap-2 rounded-lg px-5 py-3.5 font-semibold">
                        Contact Our Team
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Trust strip -->
        <section class="border-b border-slate-200 bg-white">
            <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-8 sm:px-6 md:grid-cols-4 lg:px-8">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-shield-halved text-2xl gold-text"></i>
                    <div>
                        <p class="font-semibold">Client First</p>
                        <p class="text-xs text-slate-500">Your interests matter</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-scale-balanced text-2xl gold-text"></i>
                    <div>
                        <p class="font-semibold">Professional</p>
                        <p class="text-xs text-slate-500">Ethical representation</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-lock text-2xl gold-text"></i>
                    <div>
                        <p class="font-semibold">Confidential</p>
                        <p class="text-xs text-slate-500">Privacy-focused service</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-comments text-2xl gold-text"></i>
                    <div>
                        <p class="font-semibold">Clear Advice</p>
                        <p class="text-xs text-slate-500">Straightforward guidance</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- About -->
        <section id="about" class="bg-cream">
            <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:px-8 lg:py-28">
                <div class="reveal relative">
                    <img src="https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1000&q=85"
                         alt="Law library"
                         class="h-[420px] w-full rounded-2xl object-cover shadow-xl"
                         loading="lazy" />

                    <div class="absolute -bottom-5 right-4 rounded-xl bg-ink p-5 text-white shadow-xl sm:right-8">
                        <p class="font-serif text-3xl font-bold gold-text">Apex</p>
                        <p class="mt-1 text-xs text-slate-300">Your trusted legal partner</p>
                    </div>
                </div>

                <div class="reveal">
                    <p class="text-xs font-bold uppercase tracking-[.22em] gold-text">
                        About Our Firm
                    </p>
                    <h2 class="mt-4 font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
                        Dedicated to Protecting Your Rights and Interests
                    </h2>

                    <p class="mt-6 leading-8 text-slate-600">
                        At Apex Legal Chambers, we believe that effective legal
                        representation begins with listening. We work to understand
                        each client's circumstances and provide practical guidance
                        throughout the legal process.
                    </p>

                    <p class="mt-4 leading-8 text-slate-600">
                        Our approach combines careful preparation, transparent
                        communication and professional responsibility to help clients
                        make informed decisions.
                    </p>

                    <div class="mt-7 space-y-4">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-check mt-1 gold-text"></i>
                            <div>
                                <h3 class="font-semibold">Personalized Legal Strategy</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-500">
                                    Guidance based on your specific legal needs.
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-check mt-1 gold-text"></i>
                            <div>
                                <h3 class="font-semibold">Transparent Communication</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-500">
                                    Clear explanations and regular updates.
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-check mt-1 gold-text"></i>
                            <div>
                                <h3 class="font-semibold">Professional Commitment</h3>
                                <p class="mt-1 text-sm leading-6 text-slate-500">
                                    Careful preparation and responsible representation.
                                </p>
                            </div>
                        </div>
                    </div>

                    <a href="#contact"
                       class="gold-button mt-8 inline-flex items-center gap-2 rounded-lg px-6 py-3.5 font-semibold">
                        Learn More
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Practice Areas -->
        <section id="practice" class="bg-white">
            <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
                <div class="reveal mx-auto max-w-2xl text-center">
                    <p class="text-xs font-bold uppercase tracking-[.22em] gold-text">
                        Our Expertise
                    </p>
                    <h2 class="mt-4 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                        Legal Services Designed Around You
                    </h2>
                    <p class="mt-5 leading-7 text-slate-600">
                        Explore our practice areas and find professional guidance
                        for your legal concerns.
                    </p>
                </div>

                <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    <article class="service-card reveal rounded-2xl border border-slate-200 bg-white p-7">
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cream text-2xl gold-text">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                        <h3 class="mt-6 font-serif text-xl font-semibold">Corporate Law</h3>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                            Business agreements, company matters, commercial disputes
                            and legal support for organizations.
                        </p>
                        <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold gold-text">
                            Discuss Your Case <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </article>

                    <article class="service-card reveal rounded-2xl border border-slate-200 bg-white p-7">
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cream text-2xl gold-text">
                            <i class="fa-solid fa-people-roof"></i>
                        </div>
                        <h3 class="mt-6 font-serif text-xl font-semibold">Family Law</h3>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                            Professional assistance for family-related legal matters,
                            handled with care and discretion.
                        </p>
                        <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold gold-text">
                            Discuss Your Case <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </article>

                    <article class="service-card reveal rounded-2xl border border-slate-200 bg-white p-7">
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cream text-2xl gold-text">
                            <i class="fa-solid fa-file-contract"></i>
                        </div>
                        <h3 class="mt-6 font-serif text-xl font-semibold">Civil Litigation</h3>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                            Legal support for civil disputes, claims and court-related
                            proceedings.
                        </p>
                        <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold gold-text">
                            Discuss Your Case <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </article>

                    <article class="service-card reveal rounded-2xl border border-slate-200 bg-white p-7">
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cream text-2xl gold-text">
                            <i class="fa-solid fa-house"></i>
                        </div>
                        <h3 class="mt-6 font-serif text-xl font-semibold">Property Law</h3>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                            Assistance with property transactions, documentation
                            and property disputes.
                        </p>
                        <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold gold-text">
                            Discuss Your Case <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </article>

                    <article class="service-card reveal rounded-2xl border border-slate-200 bg-white p-7">
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cream text-2xl gold-text">
                            <i class="fa-solid fa-handshake"></i>
                        </div>
                        <h3 class="mt-6 font-serif text-xl font-semibold">Contract Law</h3>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                            Contract review, drafting support and assistance with
                            contractual disputes.
                        </p>
                        <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold gold-text">
                            Discuss Your Case <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </article>

                    <article class="service-card reveal rounded-2xl border border-slate-200 bg-white p-7">
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cream text-2xl gold-text">
                            <i class="fa-solid fa-scale-unbalanced"></i>
                        </div>
                        <h3 class="mt-6 font-serif text-xl font-semibold">Criminal Law</h3>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                            Legal consultation and representation for criminal
                            proceedings and related matters.
                        </p>
                        <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold gold-text">
                            Discuss Your Case <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </article>
                </div>
            </div>
        </section>

        <!-- Approach -->
        <section class="bg-ink text-white">
            <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-24">
                <div class="reveal">
                    <p class="text-xs font-bold uppercase tracking-[.22em] gold-text">
                        How We Work
                    </p>
                    <h2 class="mt-4 font-serif text-3xl font-semibold leading-tight sm:text-4xl">
                        A Clear Process. A Stronger Legal Strategy.
